# Starknet RPC
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_KEY
STARKNET_SEPOLIA_RPC_URL=https://starknet-sepolia.g.alchemy.com/v2/YOUR_KEY

# Network override (optional): "mainnet", "sepolia", or "devnet"
# Set to "devnet" when targeting a starknet-devnet-rs instance (local or remote).
# When devnet: HTTP RPC URLs are allowed, avnu defaults to sepolia endpoints,
# chain ID assertions are skipped, and deploy safety gates are relaxed.
# STARKNET_NETWORK=devnet
# STARKNET_RPC_URL=http://127.0.0.1:5050          # local devnet
# STARKNET_RPC_URL=http://devnet.example.com:5050  # remote devnet

# Agent Account
STARKNET_ACCOUNT_ADDRESS=0x...
STARKNET_PRIVATE_KEY=0x...

# avnu API (optional - defaults shown)
AVNU_BASE_URL=https://starknet.api.avnu.fi
AVNU_PAYMASTER_URL=https://starknet.paymaster.avnu.fi

# avnu Integrator (optional -- for integrator fees)
AVNU_API_KEY=