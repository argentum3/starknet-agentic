# =============================================================================
# Starknet Devnet Configuration
# =============================================================================
# Copy this file to .env when working with starknet-devnet-rs.
#
# Quick start:
#   1. cp .env.devnet.example .env
#   2. docker compose -f docker-compose.devnet.yml up -d
#   3. Copy a predeployed account address + private key from the devnet logs:
#        docker compose -f docker-compose.devnet.yml logs devnet
#   4. Fill in STARKNET_ACCOUNT_ADDRESS and STARKNET_PRIVATE_KEY below
#   5. Run your commands (deploy, test, MCP server, etc.)

# =============================================================================
# NETWORK
# =============================================================================
STARKNET_NETWORK=devnet

# Local devnet (default docker-compose setup):
STARKNET_RPC_URL=http://127.0.0.1:5050

# Remote devnet (uncomment and set your host):
# STARKNET_RPC_URL=http://devnet.example.com:5050

# =============================================================================
# AGENT / DEPLOYER ACCOUNT
# =============================================================================
# Use a predeployed account from devnet (printed in container logs).
# With --seed 0, account #0 is always:
STARKNET_ACCOUNT_ADDRESS=0x64b48806902a367c8598f4f95c305e8c1a1acba5f082d294a43793113115691
STARKNET_PRIVATE_KEY=0x71d7bb07b9a64f6f78ac4c816aff4da9

# Aliases used by deployment scripts:
DEPLOYER_ADDRESS=0x64b48806902a367c8598f4f95c305e8c1a1acba5f082d294a43793113115691
DEPLOYER_PRIVATE_KEY=0x71d7bb07b9a64f6f78ac4c816aff4da9

# Second predeployed account (for E2E tests as a secondary user):
TEST_ACCOUNT_ADDRESS=0x78662e7352d062084b0010068b99288486c2d8b914f6e2a55ce945f8792c8b1
TEST_ACCOUNT_PRIVATE_KEY=0xe1406455b7d66b1690803be066cbe5e

# =============================================================================
# CONTRACT ADDRESSES (set after deploying to devnet)
# =============================================================================
# Deploy ERC-8004 contracts:  cd contracts/erc8004-cairo && node scripts/deploy.js
# Deploy agent account factory: cd contracts/agent-account && node scripts/deploy.js
# ERC8004_IDENTITY_REGISTRY_ADDRESS=0x...
# ERC8004_REPUTATION_REGISTRY_ADDRESS=0x...
# ERC8004_VALIDATION_REGISTRY_ADDRESS=0x...
# AGENT_ACCOUNT_FACTORY_ADDRESS=0x...

# =============================================================================
# AVNU (optional — devnet has no avnu liquidity, but endpoints won't break)
# =============================================================================
# AVNU_BASE_URL=https://sepolia.api.avnu.fi
# AVNU_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi

# =============================================================================
# SIGNER MODE
# =============================================================================
# Default: "direct" (uses STARKNET_PRIVATE_KEY directly).
# Cartridge Controller proxy mode requires a running keyring proxy service.
# On devnet, "direct" mode is recommended.
STARKNET_SIGNER_MODE=direct

# =============================================================================
# DEVNET LIMITATIONS
# =============================================================================
# The following MCP tools will NOT work on devnet (no external service):
#   - starknet_swap, starknet_get_quote, starknet_build_swap_calls (no avnu liquidity)
#   - starknet_vesu_deposit, starknet_vesu_withdraw, starknet_vesu_positions (no Vesu pools)
#   - gasfree=true is silently downgraded to standard execution (no paymaster)
#
# The following tools WORK on devnet:
#   - starknet_get_balance, starknet_get_balances (ETH/STRK predeployed)
#   - starknet_transfer (between predeployed accounts)
#   - starknet_call_contract, starknet_invoke_contract
#   - starknet_estimate_fee
#   - starknet_build_calls, starknet_build_transfer_calls
#   - starknet_register_agent, starknet_set/get_agent_metadata (after deploying ERC-8004)
#   - starknet_deploy_agent_account (after deploying factory)
#   - starknet_register/revoke/get_session_key (after deploying agent account)

# =============================================================================
# DOCKER COMPOSE OVERRIDES (used by docker-compose.devnet.yml)
# =============================================================================
# DEVNET_PORT=5050
# DEVNET_SEED=0
# DEVNET_ACCOUNTS=10
# DEVNET_INITIAL_BALANCE=1000000000000000000000
# DEVNET_GAS_PRICE=100000000000
